{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sectionxscoreboard",
  "account_id": "3ea6b1d4da3e65818d3d2034576083bb",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CLOUDFLARE_AUTOMATION_ENABLED": "false"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "build": {
    "command": "npm run cloudflare:build"
  },
  "triggers": {
    "crons": [
      "0 11 * * *",
      "30 10 * * *",
      "0 2 * * *",
      "0 4 * * *",
      "0 6 * * *",
      "0 8 * * *",
      "0 9 * * *",
      "0 15 * * *",
      "0 19 * * *",
      "0 23 * * *",
      "30 12 * * *",
      "*/5 * * * *",
      "*/30 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sectionxscoreboard-preview",
      "database_id": "7653dddc-8266-4cb2-a7b0-cd1428879858",
      "migrations_dir": "cloudflare/d1/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "sectionxscoreboard-photos-preview"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
