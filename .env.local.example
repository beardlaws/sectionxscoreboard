# Supabase — get these from your Supabase project dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to client, server-side only
# Used by privileged admin API routes to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin authentication — server-side only
# ADMIN_PASSWORD is what the operator enters on /admin/login.
# ADMIN_SESSION_TOKEN should be a long random secret and must NOT match the password.
# Rotate both immediately if either value is ever exposed.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_TOKEN=replace-with-a-long-random-session-secret

# Optional: for Supabase Storage
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=photos
