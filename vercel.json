{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "cloudflare-migration": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/arbiter-health",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/cross-country-sync",
      "schedule": "30 10 * * *"
